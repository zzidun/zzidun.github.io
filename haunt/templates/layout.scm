(define-module (templates layout)
  #:use-module (haunt site)
  #:export (zzidun-layout))

(define (zzidun-layout site title body)
  `((doctype "html")
    (html (@ (lang "zh-CN"))
     (head
      (meta (@ (charset "utf-8")))
      (meta (@ (name "viewport") (content "width=device-width, initial-scale=1")))
      (title ,title " — " ,(site-title site))
      (link (@ (rel "stylesheet") (href "/assets/css/fira-mono.css")))
      (link (@ (rel "stylesheet") (href "/assets/css/default.css")))
      (link (@ (rel "stylesheet") (href "/assets/css/syntax.css")))
      (link (@ (rel "stylesheet") (href "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github.min.css")))
      (link (@ (rel "shortcut icon") (href "/assets/images/zzidun-logo.png") (type "image/x-icon")))
      (script (@ (src "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js")) "")
      (script (@ (src "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/cpp.min.js")) "")
      (script (@ (src "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/bash.min.js")) "")
      (script (@ (src "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/python.min.js")) "")
      (script (@ (src "https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/languages/haskell.min.js")) "")
      (script "hljs.highlightAll();"))
     (body
      (header
       (div (@ (class "logo"))
        (a (@ (href "/")) ,(site-title site)))
       (nav
        (a (@ (href "/")) "主页")
        (a (@ (href "/links.html")) "推荐阅读")
        (a (@ (href "/archive.html")) "归档")))
      (main (@ (role "main"))
       ,body)
      (footer
       "Site generated by "
       (a (@ (href "https://dthompson.us/projects/haunt.html")) "Haunt"))))))
