(define-module (pages tags)
  #:use-module (haunt site)
  #:use-module (haunt post)
  #:use-module (haunt artifact)
  #:use-module (haunt html)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-19)
  #:export (tags-page-builder))

(define (date->string* date)
  (date->string date "~Y年~m月~d日"))

(define (make-tag-page-content site posts tag)
  (let* ((tagged-posts (filter (lambda (post) (member tag (post-tags post))) posts))
         (sorted-posts (posts/reverse-chronological tagged-posts)))
    (define (post-uri post)
      (string-append "/" (site-post-slug site post) ".html"))
    `((h1 ,tag)
      (p "共 " ,(number->string (length tagged-posts)) " 篇文章")
      (ul
       ,@(map (lambda (post)
                `(li (a (@ (href ,(post-uri post)))
                        ,(post-ref post 'title))
                      " — "
                      ,(date->string* (post-date post))))
              sorted-posts)))))

(define (tags-page-builder layout)
  (lambda (site posts)
    (let ((all-tags (delete-duplicates (apply append (map post-tags posts)))))
      (map (lambda (tag)
             (serialized-artifact
              (string-append "tags/" tag ".html")
              (layout site tag (make-tag-page-content site posts tag))
              sxml->html))
           all-tags))))
