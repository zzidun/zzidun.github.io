(define-module (pages sitemap)
  #:use-module (haunt site)
  #:use-module (haunt post)
  #:use-module (haunt artifact)
  #:use-module (sxml simple)
  #:use-module (srfi srfi-1)
  #:use-module (srfi srfi-19)
  #:use-module (pages tags-common)
  #:export (sitemap-builder))

(define (date->sitemap-date date)
  (date->string date "~Y-~m-~d"))

(define (sitemap-content site posts)
  (define domain (site-domain site))
  (define base-url (string-append "https://" domain))
  (define sorted-posts (posts/reverse-chronological posts))
  (define tags (all-tags sorted-posts))
  (define (post-url post)
    (string-append base-url "/" (site-post-slug site post) ".html"))
  (define (tag-url tag)
    (string-append base-url "/tags/" tag ".html"))
  (append
   (map (lambda (page)
          `(url (loc ,page)))
        (list (string-append base-url "/")
              (string-append base-url "/links.html")
              (string-append base-url "/archive.html")))
   (map (lambda (tag)
          `(url (loc ,(tag-url tag))))
        tags)
   (map (lambda (post)
          `(url
            (loc ,(post-url post))
            (lastmod ,(date->sitemap-date (post-date post)))))
        sorted-posts)))

(define (sitemap-xml tree port)
  (display "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n" port)
  (display "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n" port)
  (for-each (lambda (url)
              (sxml->xml url port)
              (newline port))
            tree)
  (display "</urlset>\n" port))

(define (sitemap-builder)
  (lambda (site posts)
    (list (serialized-artifact "sitemap.xml"
                               (sitemap-content site posts)
                               sitemap-xml))))
